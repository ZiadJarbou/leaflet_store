# Production runtime
NODE_ENV=production
APP_URL=https://your-domain.example
JWT_SECRET=generate-a-long-random-secret
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# Optional. Use neon-http for Neon if the host blocks direct Postgres port 5432.
PG_DRIVER=pg

# Stripe - get keys from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME

# Price IDs from https://dashboard.stripe.com/products
STRIPE_PRO_MONTHLY_PRICE_ID=price_REPLACE_ME
STRIPE_PRO_ANNUAL_PRICE_ID=price_REPLACE_ME
STRIPE_BUSINESS_MONTHLY_PRICE_ID=price_REPLACE_ME
STRIPE_BUSINESS_ANNUAL_PRICE_ID=price_REPLACE_ME

# Google Gemini image generation
GOOGLE_API_KEY=REPLACE_ME
NANO_BANANA_MODEL=gemini-3.1-flash-image-preview

# Email sending for verification links
SMTP_HOST=smtp.your-email-provider.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=no-reply@your-domain.example
SMTP_PASS=your-smtp-password
MAIL_FROM="LeafletAI <no-reply@your-domain.example>"

# Google OAuth login
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-google-oauth-client-secret

# Server-side rate limits
TRUST_PROXY_HOPS=1
RATE_LIMIT_API_MAX=600
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_PASSWORD_RESET_MAX=5
RATE_LIMIT_UPLOAD_MAX=30
RATE_LIMIT_AI_MAX=20
RATE_LIMIT_SEARCH_MAX=80
RATE_LIMIT_PAYMENT_MAX=40
RATE_LIMIT_WEBHOOK_MAX=120
