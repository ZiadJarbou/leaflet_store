# Production runtime
NODE_ENV=production
APP_URL=https://your-domain.example
JWT_SECRET=generate-a-long-random-secret

# Stripe - get keys from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME

# Price IDs from https://dashboard.stripe.com/products
STRIPE_PRO_MONTHLY_PRICE_ID=price_REPLACE_ME
STRIPE_PRO_ANNUAL_PRICE_ID=price_REPLACE_ME
STRIPE_BUSINESS_MONTHLY_PRICE_ID=price_REPLACE_ME
STRIPE_BUSINESS_ANNUAL_PRICE_ID=price_REPLACE_ME

# Google Gemini image generation
GOOGLE_API_KEY=REPLACE_ME
NANO_BANANA_MODEL=gemini-3.1-flash-image-preview

# Google OAuth login
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-google-oauth-client-secret

# Apple OAuth login
APPLE_OAUTH_CLIENT_ID=com.your-company.your-service-id
APPLE_OAUTH_TEAM_ID=YOUR_APPLE_TEAM_ID
APPLE_OAUTH_KEY_ID=YOUR_APPLE_KEY_ID
APPLE_OAUTH_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_CONTENTS\n-----END PRIVATE KEY-----"
