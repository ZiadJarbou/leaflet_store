# Production runtime
NODE_ENV=production
APP_URL=https://your-domain.example
JWT_SECRET=generate-a-long-random-secret

# Stripe - get keys from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME

# Price IDs from https://dashboard.stripe.com/products
STRIPE_PRO_MONTHLY_PRICE_ID=price_REPLACE_ME
STRIPE_PRO_ANNUAL_PRICE_ID=price_REPLACE_ME
STRIPE_BUSINESS_MONTHLY_PRICE_ID=price_REPLACE_ME
STRIPE_BUSINESS_ANNUAL_PRICE_ID=price_REPLACE_ME

# OpenAI GPT Image generation
OPENAI_API_KEY=REPLACE_ME
OPENAI_IMAGE_MODEL=gpt-image-1

# Email sending for verification links
SMTP_HOST=smtp.your-email-provider.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=no-reply@your-domain.example
SMTP_PASS=your-smtp-password
MAIL_FROM="LeafletAI <no-reply@your-domain.example>"

# Google OAuth login
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-google-oauth-client-secret
